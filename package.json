{
	"name": "magicbuttons",
	"title": "MagicButtons App",
	"description": "MagicButtons App - Show a button to only 10% of users",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"license": "MIT",
	"homepage": "https://magicbuttons.vercel.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/Saturnych/magicbuttons"
	},
	"bugs": {
		"url": "https://github.com/Saturnych/magicbuttons/issues"
	},
	"author": {
		"name": "Denis Glebko",
		"email": "saturnych@gmail.com",
		"url": "https://github.com/Saturnych"
	},
	"scripts": {
		"dev": "vite dev --port 3300 --host",
		"start": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview --port 3311 --host",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test": "playwright test"
	},
	"devDependencies": {
		"@iconify/svelte": "^5.0.1",
		"@playwright/test": "^1.54.1",
		"@sveltejs/adapter-vercel": "^5.8.1",
		"@sveltejs/kit": "^2.27.0",
		"@sveltejs/vite-plugin-svelte": "^6.1.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^24.1.0",
		"dotenv": "^17.2.1",
		"fingerprintjs2": "^2.1.4",
		"jsonwebtoken": "^9.0.2",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.37.1",
		"svelte-check": "^4.3.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.9.2",
		"vite": "^7.0.6",
		"vite-plugin-cross-origin-isolation": "^0.1.6",
		"vite-plugin-devtools-json": "^0.4.1",
		"vite-plugin-mkcert": "^1.17.8"
	},
	"dependencies": {
		"@supabase/realtime-js": "^2.14.0",
		"@supabase/supabase-js": "^2.53.0",
		"short-uuid": "^5.2.0",
		"sveltekit-sse": "^0.14.3"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"keywords": [
		"sveltekit",
		"supabase",
		"fingerprint",
		"typescript"
	]
